{
  "expo": {
    "name": "Salvō",
    "slug": "salvo-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "salvo",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.salvo.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1b0067"
      },
      "package": "com.salvo.app"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
